# --- required ---
HULY_URL=https://huly.example.com        # base URL of your self-hosted Huly instance
HULY_WORKSPACE=your_workspace_name       # workspace NAME (not id)
HULY_BOT_EMAIL=bridge-bot@example.com    # dedicated Huly account for the bridge
HULY_BOT_PASSWORD=change_me              # its password
TG_BOT_TOKEN=123456789:replace_with_botfather_token
TG_CHAT_ID=-1001234567890                # forum supergroup chat id
# --- optional (defaults shown) ---
#STATE_PATH=/data/state.json             # bridge state file (container volume)
#PEOPLE_MAP_PATH=/data/people.json       # telegram username/id -> display name map
#BRIDGE_POLL_SEC=3                       # Huly message poll interval
#BRIDGE_FULL_SYNC_SEC=600                # channel/people/deletes reconciliation interval
#BRIDGE_DELETE_SYNC_SEC=60               # fast delete-propagation sweep interval
#BRIDGE_TG_RATE_PER_MIN=18               # outgoing Telegram rate cap (Telegram limit ~20/min per group)
#LOG_LEVEL=info                          # error|warn|info|debug
